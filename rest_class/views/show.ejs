<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Post in detail</title>
    <link rel="stylesheet" href="/style.css" />
</head>
<body>

    <h2>Here is your post:</h2>
    <p>post id: <%= post.id %></p>
    <div class="post">

    <h3 class="username">@<%= post.username %></h3>

    <p class="content"><%= post.content %></p>

    <div class="btn-group">

        <a class="btn view" href="/posts/<%= post.id %>">
            View
        </a>

        <a class="btn edit" href="/posts/<%= post.id %>/edit">
            Edit
        </a>

        <form method="POST" action="/posts/<%= post.id %>?_method=DELETE">
            <button class="delete">
                Delete
            </button>
        </form>

    </div>

</div>
</body>
</html>