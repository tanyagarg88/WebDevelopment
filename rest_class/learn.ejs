<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EJS Practice Dashboard</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<%
let name = "Tanya Garg";

let skills = [
    "HTML",
    "CSS",
    "JavaScript",
    "Node.js",
    "Express.js",
    "EJS"
];

let students = [
    {
        name:"Tanya",
        age:20,
        city:"Ghaziabad",
        verified:true,
        marks:95
    },
    {
        name:"Rahul",
        age:22,
        city:"Delhi",
        verified:false,
        marks:74
    },
    {
        name:"Priya",
        age:21,
        city:"Noida",
        verified:true,
        marks:88

    },
    {
        name:"Amit",
        age:23,
        city:"Gurgaon",
        verified:false,
        marks:65
    },
    {
        name:"Sneha",
        age:19,
        city:"Faridabad",
        verified:true,
        marks:92
    }
];
%>

<h1>Welcome <%= name %> </h1>

<h2>Today's Date</h2>

<p><%= new Date().toDateString() %></p>

<hr>

<h2>Skills</h2>

<ul>

<% for(let skill of skills){ %>

<li><%= skill %></li>

<% } %>

</ul>

<hr>

<h2>Student Dashboard</h2>

<% students.forEach((student,index)=>{ %>

<div class="<%= index % 2 === 0 ? 'card-one' : 'card-two' %>">

<h3>

<%= index + 1 %>. <%= student.name %>

</h3>

<p>Age : <%= student.age %></p>

<p>City : <%= student.city %></p>

<p>Marks : <%= student.marks %></p>

<p>

Status :

<%= student.verified ? "Verified" : " Not Verified" %>

</p>

<% if(student.marks>=90){ %>

<h4> Excellent Student</h4>

<% } else if(student.marks>=75){ %>

<h4> Good Student</h4>

<% } else { %>

<h4> Needs Improvement</h4>

<% } %>

<button>View Profile</button>

</div>

<br>

<% }) %>

<hr>

<h2>Uppercase Skills</h2>

<ul>

<% skills.forEach(skill=>{ %>

<li><%= skill.toUpperCase() %></li>

<% }) %>

</ul>

<hr>

<h2>First Three Skills</h2>

<ul>

<% for(let i=0;i<3;i++){ %>

<li><%= skills[i] %></li>

<% } %>

</ul>
<hr>

<h2>Student Details</h2>

<%
let profile = {
    username: "tanya_garg",
    email: "tanya@example.com",
    location: {
        city: "Ghaziabad",
        state: "Uttar Pradesh",
        country: "India"
    },
    education: {
        course: "B.Tech",
        branch: "Computer Science",
        year: 3
    }
};
%>

<div class="profile">

    <h3><%= profile.username %></h3>

    <p>Email: <%= profile.email %></p>

    <h4>Location</h4>

    <p>
        <%= profile.location.city %>,
        <%= profile.location.state %>,
        <%= profile.location.country %>
    </p>

    <h4>Education</h4>

    <p>
        <%= profile.education.course %> -
        <%= profile.education.branch %>
    </p>

    <p>
        Year: <%= profile.education.year %>
    </p>

</div>

<hr>

<h2>Student Performance</h2>

<% students.forEach(student => { %>

    <%
        let grade;

        if(student.marks >= 90){
            grade = "A+";
        }else if(student.marks >= 80){
            grade = "A";
        }else if(student.marks >= 70){
            grade = "B";
        }else{
            grade = "C";
        }
    %>

    <div class="student">

        <h3><%= student.name %></h3>

        <p>Marks: <%= student.marks %></p>

        <p>Grade: <%= grade %></p>

        <p>
            Result:
            <%= student.marks >= 40 ? "Pass" : "Fail" %>
        </p>

    </div>

<% }) %>

<hr>

<h2>Student Names</h2>

<% students.forEach(student => { %>

    <p>
        Original:
        <%= student.name %>
    </p>

    <p>
        Uppercase:
        <%= student.name.toUpperCase() %>
    </p>

    <p>
        Lowercase:
        <%= student.name.toLowerCase() %>
    </p>

    <p>
        First Letter:
        <%= student.name.charAt(0) %>
    </p>

<% }) %>

<hr>

<h2>Dynamic Messages</h2>

<%
let hour = new Date().getHours();
%>

<% if(hour < 12){ %>

    <h3>Good Morning </h3>

<% }else if(hour < 18){ %>

    <h3>Good Afternoon </h3>

<% }else{ %>

    <h3>Good Evening </h3>

<% } %>

<hr>

<h2>Student Statistics</h2>

<%
let totalStudents = students.length;

let totalMarks = 0;

students.forEach(student => {
    totalMarks += student.marks;
});

let averageMarks = totalMarks / totalStudents;

let passedStudents = students.filter(
    student => student.marks >= 40
);

let topStudents = students.filter(
    student => student.marks >= 90
);
%>

<div class="stats">

    <div class="stat-card">

        <h3>Total Students</h3>

        <p>
            <%= totalStudents %>
        </p>

    </div>

    <div class="stat-card">

        <h3>Total Marks</h3>

        <p>
            <%= totalMarks %>
        </p>

    </div>

    

    <div class="stat-card">

        <h3>Passed Students</h3>

        <p>
            <%= passedStudents.length %>
        </p>

    </div>

    <div class="stat-card">

        <h3>Top Students</h3>

        <p>
            <%= topStudents.length %>
        </p>

    </div>

</div>

<hr>

<h2>Top Students </h2>

<% if(topStudents.length > 0){ %>

    <% topStudents.forEach(student => { %>

        <div class="top-student">

            <h3>
                <%= student.name %>
            </h3>

            <p>
                Marks: <%= student.marks %>
            </p>

        </div>

    <% }) %>

<% }else{ %>

    <p>No top students found.</p>

<% } %>

<hr>

<h2>Dynamic Classes</h2>

<% students.forEach(student => { %>

    <%
        let statusClass =
            student.marks >= 80
            ? "excellent"
            : "average";
    %>

    <div class="<%= statusClass %>">

        <h3>
            <%= student.name %>
        </h3>

        <p>
            Marks: <%= student.marks %>
        </p>

    </div>

<% }) %>

<hr>
<nav>
    <h2>My Website</h2>

    <div>
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
    </div>
</nav>
<!DOCTYPE html>
<html>
<head>
    <title>My Website</title>
</head>

<body>

    <%- include("partials/navbar") %>

    <main>
        <h1>Welcome to my website</h1>
        <p>I am learning EJS and Express.</p>
    </main>

    <%- include("partials/footer") %>

</body>
</html>

